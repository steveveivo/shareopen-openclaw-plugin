  },
  "keywords": [
    "openclaw",
    "plugin",
    "channel",
    "shareopen",
    "agent",
    "im",
    "messaging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steveveivo/shareopen-openclaw-plugin.git"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.cjs",
    "setup.js",
    "setup.cjs",
    "setup.mjs",
    "plugin-api.mjs",
    "openclaw.plugin.json",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {},
  "homepage": "https://github.com/steveveivo/shareopen-openclaw-plugin"
}