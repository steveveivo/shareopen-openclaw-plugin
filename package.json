{
  "name": "openclaw-channel-shareopen",
  "version": "1.3.4",
  "main": "./index.js",
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "setupEntry": "./setup.js",
    "channel": {
      "id": "shareopen",
      "label": "ShareOpen",
      "blurb": "ShareOpen IM platform"
    },
    "compat": {
      "pluginApi": "1.0"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
